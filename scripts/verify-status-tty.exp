#!/usr/bin/expect -f

set timeout 15
set project_root [lindex $argv 0]

spawn env TERM=xterm-256color /bin/bash -c "cd $project_root && cargo run -q -p vole-cli -- status"

expect {
    timeout { exit 124 }
    eof { exit 1 }
}

# 若进入 TUI，发送 q 退出；若立即退出则跳过
sleep 1
send "q"

expect {
    timeout { }
    eof { }
}

spawn /bin/bash -c "printf 'typed-after\n'"

expect {
    -re {typed-after\r?\n} {}
    timeout { exit 124 }
    eof { exit 1 }
}

send -- "typed-after\r"

expect {
    -re {typed-after\r?\n} {}
    timeout { exit 124 }
    eof { exit 1 }
}

exit 0
