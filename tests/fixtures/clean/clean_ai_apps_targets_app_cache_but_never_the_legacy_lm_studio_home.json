{
  "id": "clean_ai_apps_targets_app_cache_but_never_the_legacy_lm_studio_home",
  "source_bats": "third_party/mole-1.48.1/tests/clean_app_caches.bats",
  "source_test": "clean_ai_apps targets app cache but never the legacy LM Studio home",
  "fixture": [
    {
      "mkdir": "~/.cache/lm-studio/models"
    },
    {
      "mkdir": "~/.lmstudio/models"
    },
    {
      "mkdir": "~/Library/Caches/com.lmstudio.lmstudio"
    },
    {
      "write": "~/Library/Caches/com.lmstudio.lmstudio/cache.bin",
      "content": "cache"
    },
    {
      "write": "~/.cache/lm-studio/models/keep.gguf",
      "content": "model"
    },
    {
      "write": "~/.lmstudio/models/keep.gguf",
      "content": "model"
    }
  ],
  "expect_not_selected": [
    "HOME/.cache/lm-studio",
    "HOME/.lmstudio"
  ]
}
