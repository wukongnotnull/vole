    {
      "mkdir": "~/Library/Application Support/Claude/claude-code/2.1.140",
      "mtime": "2026-04-01T00:00"
    },
    {
      "mkdir": "~/Library/Application Support/Claude/claude-code/2.1.142",
      "mtime": "2026-04-15T00:00"
    },
    {
      "mkdir": "~/Library/Application Support/Claude/claude-code/2.1.150",
